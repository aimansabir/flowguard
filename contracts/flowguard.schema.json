{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracts",
  "description": "Wrapper so one schema file carries every contract type.",
  "type": "object",
  "properties": {
    "measurement": {
      "$ref": "#/$defs/Measurement"
    },
    "approach_state": {
      "$ref": "#/$defs/ApproachState"
    },
    "command": {
      "$ref": "#/$defs/Command"
    },
    "corridor": {
      "$ref": "#/$defs/Corridor"
    },
    "core_config": {
      "$ref": "#/$defs/CoreConfig"
    },
    "step_output": {
      "$ref": "#/$defs/StepOutput"
    }
  },
  "required": [
    "measurement",
    "approach_state",
    "command",
    "corridor",
    "core_config",
    "step_output"
  ],
  "$defs": {
    "Measurement": {
      "description": "Producer -> core. One per approach per interval. Raw, unweighted counts:\nPCU weighting and every judgement about trust happen in the core.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "2.0"
        },
        "time": {
          "description": "End of the interval, seconds since the start of the run.",
          "type": "number",
          "format": "double"
        },
        "interval_s": {
          "description": "Interval length, seconds. 1.0 in the simulator.",
          "type": "number",
          "format": "double"
        },
        "junction_id": {
          "type": "string"
        },
        "approach_id": {
          "description": "Incoming approach the producer watches (SUMO edge id in the simulator).",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "zone_length_m": {
          "description": "Length of road the producer can see, metres back from the stop line.",
          "type": "number",
          "format": "double"
        },
        "zone_counts": {
          "description": "Vehicles inside the zone at `time`.",
          "$ref": "#/$defs/ClassCounts"
        },
        "queue_counts": {
          "description": "Of those, vehicles stopped (speed < 0.1 m/s).",
          "$ref": "#/$defs/ClassCounts"
        },
        "arrivals": {
          "description": "Vehicles that entered the zone during the interval.",
          "$ref": "#/$defs/ClassCounts"
        },
        "departures": {
          "description": "Vehicles that crossed the stop line during the interval, by movement.",
          "$ref": "#/$defs/MovementCounts"
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": {
            "detector_confidence": null,
            "track_breaks_per_min": null,
            "image_health": null,
            "count_error": null
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "time",
        "interval_s",
        "junction_id",
        "approach_id",
        "source",
        "zone_length_m",
        "zone_counts",
        "queue_counts",
        "arrivals",
        "departures"
      ]
    },
    "Source": {
      "description": "Where a measurement came from.",
      "oneOf": [
        {
          "description": "SUMO ground truth, cut to the camera zone.",
          "type": "string",
          "const": "sim"
        },
        {
          "description": "Live or recorded camera through the vision pipeline.",
          "type": "string",
          "const": "camera"
        },
        {
          "description": "Historical counts replayed from a file.",
          "type": "string",
          "const": "replay"
        }
      ]
    },
    "ClassCounts": {
      "description": "Vehicles per class. Exactly these six classes; anything else is rejected.",
      "type": "object",
      "properties": {
        "car": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "motorcycle": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rickshaw": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "qingqi": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "truck": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "car",
        "motorcycle",
        "rickshaw",
        "qingqi",
        "bus",
        "truck"
      ]
    },
    "MovementCounts": {
      "description": "Counts split by the movement the vehicles took.",
      "type": "object",
      "properties": {
        "left": {
          "$ref": "#/$defs/ClassCounts"
        },
        "straight": {
          "$ref": "#/$defs/ClassCounts"
        },
        "right": {
          "$ref": "#/$defs/ClassCounts"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "straight",
        "right"
      ]
    },
    "Quality": {
      "description": "The producer's own evidence about measurement quality. All optional: the\nsimulator leaves everything null, the camera pipeline fills what it can.",
      "type": "object",
      "properties": {
        "detector_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectorConfidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "track_breaks_per_min": {
          "description": "Tracks lost and restarted, per minute.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "image_health": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "count_error": {
          "description": "Producer estimate of how wrong `zone_counts` might be, vehicles.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "DetectorConfidence": {
      "type": "object",
      "properties": {
        "mean": {
          "description": "Mean detector score over the interval, 0-1.",
          "type": "number",
          "format": "double"
        },
        "std": {
          "description": "Standard deviation of detector scores over the interval.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "mean",
        "std"
      ]
    },
    "ImageHealth": {
      "type": "object",
      "properties": {
        "frozen": {
          "description": "Consecutive frames near-identical.",
          "type": "boolean"
        },
        "blur": {
          "description": "0 = sharp, 1 = unusable.",
          "type": "number",
          "format": "double"
        },
        "brightness": {
          "description": "Mean brightness, 0 = black, 1 = saturated.",
          "type": "number",
          "format": "double"
        },
        "displacement_px": {
          "description": "Scene shift against the reference frame, pixels.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "frozen",
        "blur",
        "brightness",
        "displacement_px"
      ]
    },
    "ApproachState": {
      "description": "The core view of one approach after the Guard. What controllers decide on.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "2.0"
        },
        "time": {
          "type": "number",
          "format": "double"
        },
        "junction_id": {
          "type": "string"
        },
        "approach_id": {
          "type": "string"
        },
        "measured_queue_pcu": {
          "description": "Queue as measured, PCU.",
          "type": "number",
          "format": "double"
        },
        "queue_estimate": {
          "description": "Queue controllers should use, PCU. Equals the measured queue when trusted.",
          "type": "number",
          "format": "double"
        },
        "margin": {
          "description": "+/- uncertainty on `queue_estimate`, PCU.",
          "type": "number",
          "format": "double"
        },
        "trust_state": {
          "$ref": "#/$defs/TrustState"
        },
        "override_flag": {
          "description": "True when `queue_estimate` is not the measured queue.",
          "type": "boolean"
        },
        "arrivals_pcu": {
          "description": "Arrivals into the zone this interval, PCU.",
          "type": "number",
          "format": "double"
        },
        "departures_pcu": {
          "description": "Departures over the stop line this interval, PCU.",
          "type": "number",
          "format": "double"
        },
        "exits_to": {
          "description": "Departures this interval heading to each neighbouring junction, vehicles.\nA key for every neighbour of this junction, 0 if none.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "time",
        "junction_id",
        "approach_id",
        "measured_queue_pcu",
        "queue_estimate",
        "margin",
        "trust_state",
        "override_flag",
        "arrivals_pcu",
        "departures_pcu",
        "exits_to"
      ]
    },
    "TrustState": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "SUSPECT",
        "FAULTY"
      ]
    },
    "Command": {
      "description": "Safety envelope -> signals, one per junction per second.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "2.0"
        },
        "time": {
          "description": "Second this command applies to.",
          "type": "number",
          "format": "double"
        },
        "junction_id": {
          "type": "string"
        },
        "phase_index": {
          "description": "Phase whose approaches are lit: the green phase, or the phase being cleared.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "phase_started_at": {
          "description": "When the current `stage` began, seconds.",
          "type": "number",
          "format": "double"
        },
        "controller_name": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "target_phase": {
          "description": "Phase being switched to; equals `phase_index` when settled.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requested_phase": {
          "description": "What the controller asked for this second, null if nothing.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "intervention": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intervention"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "time",
        "junction_id",
        "phase_index",
        "phase_started_at",
        "controller_name",
        "stage",
        "target_phase"
      ]
    },
    "Stage": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "all_red"
      ]
    },
    "Intervention": {
      "description": "Why the envelope did something other than what the controller asked.",
      "type": "string",
      "enum": [
        "min_green",
        "max_red",
        "invalid_request"
      ]
    },
    "Corridor": {
      "description": "Static map knowledge. Not live state, so every component may read it.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "2.0"
        },
        "junctions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Junction"
          }
        },
        "approaches": {
          "description": "Grouped by junction, in junction order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Approach"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exit"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "junctions",
        "approaches",
        "entries",
        "exits"
      ]
    },
    "Junction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "phases": {
          "description": "Phase index -> approaches that get green in that phase.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "links": {
          "description": "Signal links in the order the signal state string uses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalLink"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "phases",
        "links"
      ]
    },
    "SignalLink": {
      "description": "One signal link in SUMO link order: which approach it serves and its SUMO\ndirection code (s, l, r, L, R, t).",
      "type": "object",
      "properties": {
        "approach": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "approach",
        "direction"
      ]
    },
    "Approach": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "junction": {
          "type": "string"
        },
        "length_m": {
          "description": "Edge length up to the stop line, metres.",
          "type": "number",
          "format": "double"
        },
        "lanes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "movements": {
          "$ref": "#/$defs/MovementTargets"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "junction",
        "length_m",
        "lanes",
        "movements"
      ]
    },
    "MovementTargets": {
      "description": "Edge each movement leads onto, null if the movement does not exist.",
      "type": "object",
      "properties": {
        "left": {
          "type": [
            "string",
            "null"
          ]
        },
        "straight": {
          "type": [
            "string",
            "null"
          ]
        },
        "right": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Entry": {
      "description": "Edge where traffic enters the corridor.",
      "type": "object",
      "properties": {
        "edge": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RoadKind"
        },
        "through_exit": {
          "description": "Exit edge reached by going straight at every junction.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "edge",
        "kind",
        "through_exit"
      ]
    },
    "RoadKind": {
      "type": "string",
      "enum": [
        "main",
        "side"
      ]
    },
    "Exit": {
      "description": "Edge where traffic leaves the corridor.",
      "type": "object",
      "properties": {
        "edge": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RoadKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "edge",
        "kind"
      ]
    },
    "CoreConfig": {
      "type": "object",
      "properties": {
        "pcu": {
          "$ref": "#/$defs/PcuWeights"
        },
        "timing": {
          "$ref": "#/$defs/SignalTiming"
        },
        "controller": {
          "$ref": "#/$defs/ControllerConfig"
        },
        "guard": {
          "$ref": "#/$defs/GuardConfig",
          "default": {
            "kind": "passthrough"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "pcu",
        "timing",
        "controller"
      ]
    },
    "PcuWeights": {
      "description": "Passenger car units per vehicle class. Calibration data, owned by the core.",
      "type": "object",
      "properties": {
        "car": {
          "type": "number",
          "format": "double"
        },
        "motorcycle": {
          "type": "number",
          "format": "double"
        },
        "rickshaw": {
          "type": "number",
          "format": "double"
        },
        "qingqi": {
          "type": "number",
          "format": "double"
        },
        "bus": {
          "type": "number",
          "format": "double"
        },
        "truck": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "car",
        "motorcycle",
        "rickshaw",
        "qingqi",
        "bus",
        "truck"
      ]
    },
    "SignalTiming": {
      "description": "Safety envelope limits, seconds.",
      "type": "object",
      "properties": {
        "min_green_s": {
          "type": "number",
          "format": "double"
        },
        "max_red_s": {
          "type": "number",
          "format": "double"
        },
        "yellow_s": {
          "type": "number",
          "format": "double"
        },
        "all_red_s": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "min_green_s",
        "max_red_s",
        "yellow_s",
        "all_red_s"
      ]
    },
    "ControllerConfig": {
      "oneOf": [
        {
          "title": "FixedControllerConfig",
          "description": "Fixed-time plan: green seconds per phase, same at every junction.\n`offsets_s` shifts a junction's plan later by that many seconds\n(green wave); junctions left out have offset 0 (D21).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "green_s": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "offsets_s": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "green_s"
          ]
        },
        {
          "title": "MaxPressureControllerConfig",
          "description": "Max-pressure, re-decided every second. Without `hysteresis` this is the\nbasic version (D12); with it, greens are held for min green and only\ngiven up for a clear pressure gain (D20).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maxpressure"
            },
            "hysteresis": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Hysteresis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capacity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Capacity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "serve_queue": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ServeQueue"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Hysteresis": {
      "description": "Switching damper for max-pressure.",
      "type": "object",
      "properties": {
        "gain_pcu": {
          "description": "Switch only when the best phase beats the current one by more than\nthis, PCU. 0 = any strict gain.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "gain_pcu"
      ]
    },
    "Capacity": {
      "description": "Spillback protection for max-pressure (D22): an approach adds no\npositive pressure while the approach it feeds is nearly full.",
      "type": "object",
      "properties": {
        "jam_spacing_m": {
          "description": "Road length one queued PCU takes, m. Storage of an approach =\nlength_m x lanes / jam_spacing_m, in PCU.",
          "type": "number",
          "format": "double"
        },
        "spillback_occupancy": {
          "description": "Occupancy (queue / storage, 0-1) at or above which an approach is\ntreated as full.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "jam_spacing_m",
        "spillback_occupancy"
      ]
    },
    "ServeQueue": {
      "description": "Actuated extension for max-pressure (D32): keep the green on an approach\nthat is still discharging a queue. With one phase per approach every\nswitch costs a clearance, so ending a green while its queue still flows\nat saturation throws capacity away. The envelope's max red still applies.",
      "type": "object",
      "properties": {
        "hold_pcu_per_lane": {
          "description": "Keep the current phase while one of its approaches still has at least\nthis queue per lane (PCU) and a positive pressure term (it can move).",
          "type": "number",
          "format": "double"
        },
        "max_green_s": {
          "description": "Longest green the extension keeps, s.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "hold_pcu_per_lane",
        "max_green_s"
      ]
    },
    "GuardConfig": {
      "description": "Which Guard rates the measurements.",
      "oneOf": [
        {
          "title": "PassthroughGuardConfig",
          "description": "Trust every measurement as it is (the naive adaptive baseline).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "passthrough"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "title": "GuardV1Config",
          "description": "Evidence (G1), trust state machine (G2) and virtual sensor (G3) of\ndocs/specs/guard.md. Every block and field may be left out for its\ndefault: `{\"kind\": \"v1\"}` is the documented Guard (D26).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "v1"
            },
            "evidence": {
              "$ref": "#/$defs/EvidenceConfig",
              "default": {
                "quality": {
                  "brightness_edge": 0.05,
                  "blur_max": 0.7,
                  "confidence_min": 0.3,
                  "track_breaks_max": 30.0,
                  "displacement_max_px": 20.0,
                  "weight": 0.5
                },
                "frozen": {
                  "frozen_s": 20.0,
                  "supply_s": 60.0,
                  "standing_weight": 0.5
                },
                "conservation": {
                  "window": 60,
                  "block": 5,
                  "tolerance": 1.0
                },
                "link": {
                  "free_flow_mps": 13.89,
                  "fast_factor": 1.2,
                  "slack_s": 30.0,
                  "min_spacing_m": 3.5,
                  "congested_fraction": 0.5,
                  "saturation_flow": 0.5,
                  "window_s": 120.0,
                  "min_volume_pcu": 10.0,
                  "tolerance": 0.2
                },
                "response": {
                  "startup_s": 4.0,
                  "stall_s": 15.0,
                  "stall_weight": 0.5,
                  "red_window_s": 120.0,
                  "red_floor_s": 60.0,
                  "red_tolerance_per_min": {
                    "left": 2.0,
                    "straight": 2.0,
                    "right": 2.0
                  }
                },
                "silence": {
                  "p_start": 0.001,
                  "p_full": 0.00001
                }
              }
            },
            "combine": {
              "$ref": "#/$defs/CombineConfig",
              "default": {
                "weights": {
                  "quality": 1.0,
                  "frozen": 1.0,
                  "conservation": 1.0,
                  "cross_junction": 1.0,
                  "stalled_green": 1.0,
                  "red_departures": 1.0,
                  "silence": 1.0
                }
              }
            },
            "trust": {
              "$ref": "#/$defs/TrustConfig",
              "default": {
                "suspect_score": 0.5,
                "suspect_s": 5.0,
                "faulty_score": 0.9,
                "faulty_s": 10.0,
                "recover_s": 30.0
              }
            },
            "virtual_sensor": {
              "$ref": "#/$defs/VirtualSensorConfig",
              "default": {
                "arrival_window_s": 300.0,
                "margin_growth_pcu_per_s": 0.05,
                "extend_queue_beyond_zone": false
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "EvidenceConfig": {
      "description": "Guard evidence parameters, one block per check (D24, D25). All\nprovisional research values.",
      "type": "object",
      "properties": {
        "quality": {
          "$ref": "#/$defs/QualityEvidence",
          "default": {
            "brightness_edge": 0.05,
            "blur_max": 0.7,
            "confidence_min": 0.3,
            "track_breaks_max": 30.0,
            "displacement_max_px": 20.0,
            "weight": 0.5
          }
        },
        "frozen": {
          "$ref": "#/$defs/FrozenEvidence",
          "default": {
            "frozen_s": 20.0,
            "supply_s": 60.0,
            "standing_weight": 0.5
          }
        },
        "conservation": {
          "$ref": "#/$defs/ConservationEvidence",
          "default": {
            "window": 60,
            "block": 5,
            "tolerance": 1.0
          }
        },
        "link": {
          "$ref": "#/$defs/LinkEvidence",
          "default": {
            "free_flow_mps": 13.89,
            "fast_factor": 1.2,
            "slack_s": 30.0,
            "min_spacing_m": 3.5,
            "congested_fraction": 0.5,
            "saturation_flow": 0.5,
            "window_s": 120.0,
            "min_volume_pcu": 10.0,
            "tolerance": 0.2
          }
        },
        "response": {
          "$ref": "#/$defs/ResponseEvidence",
          "default": {
            "startup_s": 4.0,
            "stall_s": 15.0,
            "stall_weight": 0.5,
            "red_window_s": 120.0,
            "red_floor_s": 60.0,
            "red_tolerance_per_min": {
              "left": 2.0,
              "straight": 2.0,
              "right": 2.0
            }
          }
        },
        "silence": {
          "$ref": "#/$defs/SilenceEvidence",
          "default": {
            "p_start": 0.001,
            "p_full": 0.00001
          }
        }
      },
      "additionalProperties": false
    },
    "QualityEvidence": {
      "description": "E1: the producer's quality report. Any bad flag scores `weight`.",
      "type": "object",
      "properties": {
        "brightness_edge": {
          "description": "Brightness at or below this is black, at or above 1 - this saturated.",
          "type": "number",
          "format": "double",
          "default": 0.05
        },
        "blur_max": {
          "description": "Blur above this (0 sharp, 1 unusable).",
          "type": "number",
          "format": "double",
          "default": 0.7
        },
        "confidence_min": {
          "description": "Mean detector confidence below this.",
          "type": "number",
          "format": "double",
          "default": 0.3
        },
        "track_breaks_max": {
          "description": "Track breaks per minute above this.",
          "type": "number",
          "format": "double",
          "default": 30.0
        },
        "displacement_max_px": {
          "description": "Scene shift above this, pixels.",
          "type": "number",
          "format": "double",
          "default": 20.0
        },
        "weight": {
          "description": "Score of a bad flag, below 1: a bad image is not proof of bad counts.",
          "type": "number",
          "format": "double",
          "default": 0.5
        }
      },
      "additionalProperties": false
    },
    "FrozenEvidence": {
      "description": "E2: counts repeating when they should change.",
      "type": "object",
      "properties": {
        "frozen_s": {
          "description": "Seconds of suspicious repetition for a score of 1.",
          "type": "number",
          "format": "double",
          "default": 20.0
        },
        "supply_s": {
          "description": "An upstream departure toward the approach counts as supply this long, s.",
          "type": "number",
          "format": "double",
          "default": 60.0
        },
        "standing_weight": {
          "description": "Score cap for a repeated standing queue, which a blocked exit gives too.",
          "type": "number",
          "format": "double",
          "default": 0.5
        }
      },
      "additionalProperties": false
    },
    "ConservationEvidence": {
      "description": "E5: zone(t) - zone(t-1) - arrivals + departures.",
      "type": "object",
      "properties": {
        "window": {
          "description": "Residuals kept, intervals.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 60
        },
        "block": {
          "description": "Residuals summed over blocks this long, so late departures cancel.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 5
        },
        "tolerance": {
          "description": "Mean |block residual| tolerated, vehicles. Score 1 at twice this.",
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false
    },
    "LinkEvidence": {
      "description": "E3: PCU balance on each link between junctions. `free_flow_mps`,\n`saturation_flow` and `min_spacing_m` also drive the virtual sensor (G3).",
      "type": "object",
      "properties": {
        "free_flow_mps": {
          "description": "Free-flow speed on links, m/s (not in the corridor map).",
          "type": "number",
          "format": "double",
          "default": 13.89
        },
        "fast_factor": {
          "description": "The fastest drivers go this much over free-flow speed.",
          "type": "number",
          "format": "double",
          "default": 1.2
        },
        "slack_s": {
          "description": "Extra seconds the slowest trip may take.",
          "type": "number",
          "format": "double",
          "default": 30.0
        },
        "min_spacing_m": {
          "description": "Metres of lane one PCU takes in the densest standing queue; link\nstorage = length x lanes / this. Not max-pressure's `jam_spacing_m`.",
          "type": "number",
          "format": "double",
          "default": 3.5
        },
        "congested_fraction": {
          "description": "A zone counts as congested, a link as full, from this share of storage.",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "saturation_flow": {
          "description": "PCU per second per lane a released queue discharges at.",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "window_s": {
          "description": "Seconds of corrections and sent PCU compared.",
          "type": "number",
          "format": "double",
          "default": 120.0
        },
        "min_volume_pcu": {
          "description": "Sent PCU below this count as this much in a window.",
          "type": "number",
          "format": "double",
          "default": 10.0
        },
        "tolerance": {
          "description": "Share of sent PCU the balance may be corrected by. Score 1 at twice this.",
          "type": "number",
          "format": "double",
          "default": 0.2
        }
      },
      "additionalProperties": false
    },
    "ResponseEvidence": {
      "description": "E4: queues discharge under green, nothing leaves under red.",
      "type": "object",
      "properties": {
        "startup_s": {
          "description": "Seconds into green before departures are expected.",
          "type": "number",
          "format": "double",
          "default": 4.0
        },
        "stall_s": {
          "description": "Seconds of stalled green for the full stall score.",
          "type": "number",
          "format": "double",
          "default": 15.0
        },
        "stall_weight": {
          "description": "Cap on the stall score: gridlock and incidents stall queues too.",
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "red_window_s": {
          "description": "Seconds of history for red-light departures.",
          "type": "number",
          "format": "double",
          "default": 120.0
        },
        "red_floor_s": {
          "description": "Red seconds below this count as this many.",
          "type": "number",
          "format": "double",
          "default": 60.0
        },
        "red_tolerance_per_min": {
          "description": "Red-light departures per minute of red tolerated.",
          "$ref": "#/$defs/PerMovement",
          "default": {
            "left": 2.0,
            "straight": 2.0,
            "right": 2.0
          }
        }
      },
      "additionalProperties": false
    },
    "PerMovement": {
      "type": "object",
      "properties": {
        "left": {
          "type": "number",
          "format": "double"
        },
        "straight": {
          "type": "number",
          "format": "double"
        },
        "right": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "straight",
        "right"
      ]
    },
    "SilenceEvidence": {
      "description": "E6: a camera reporting nothing at all for longer than its own trusted\narrival rate makes plausible (D28). Probability of the silence\np = exp(-rate x seconds); evidence from `p_start`, full at `p_full`.",
      "type": "object",
      "properties": {
        "p_start": {
          "type": "number",
          "format": "double",
          "default": 0.001
        },
        "p_full": {
          "type": "number",
          "format": "double",
          "default": 0.00001
        }
      },
      "additionalProperties": false
    },
    "CombineConfig": {
      "description": "How the evidence becomes one score per approach (D26): noisy-OR,\n`1 - product(1 - weight x score)` over the checks that could judge.",
      "type": "object",
      "properties": {
        "weights": {
          "$ref": "#/$defs/CheckWeights",
          "default": {
            "quality": 1.0,
            "frozen": 1.0,
            "conservation": 1.0,
            "cross_junction": 1.0,
            "stalled_green": 1.0,
            "red_departures": 1.0,
            "silence": 1.0
          }
        }
      },
      "additionalProperties": false
    },
    "CheckWeights": {
      "description": "0-1 multiplier per check; 0 leaves a check out (ablations).",
      "type": "object",
      "properties": {
        "quality": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "frozen": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "conservation": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "cross_junction": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "stalled_green": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "red_departures": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "silence": {
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false
    },
    "TrustConfig": {
      "description": "G2 hysteresis. TRUSTED -> SUSPECT once the score has been at least\n`suspect_score` for `suspect_s` seconds; SUSPECT -> FAULTY once it has\nbeen at least `faulty_score` for `faulty_s` seconds; back to TRUSTED\nafter `recover_s` judged seconds below `suspect_score` (D26).",
      "type": "object",
      "properties": {
        "suspect_score": {
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "suspect_s": {
          "type": "number",
          "format": "double",
          "default": 5.0
        },
        "faulty_score": {
          "type": "number",
          "format": "double",
          "default": 0.9
        },
        "faulty_s": {
          "type": "number",
          "format": "double",
          "default": 10.0
        },
        "recover_s": {
          "type": "number",
          "format": "double",
          "default": 30.0
        }
      },
      "additionalProperties": false
    },
    "VirtualSensorConfig": {
      "description": "G3 virtual sensor (D26). Discharge and travel time use\n`evidence.link.saturation_flow` and `free_flow_mps`.",
      "type": "object",
      "properties": {
        "arrival_window_s": {
          "description": "Trusted seconds the arrival rate is averaged over (entry approaches,\nand internal ones whose upstream cannot be used).",
          "type": "number",
          "format": "double",
          "default": 300.0
        },
        "margin_growth_pcu_per_s": {
          "description": "`margin` growth per second since the last trusted reading, PCU/s.",
          "type": "number",
          "format": "double",
          "default": 0.05
        },
        "extend_queue_beyond_zone": {
          "description": "While TRUSTED with a full zone, report the virtual queue when it is\nlonger than the camera can see (the queue extends past the zone).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "StepOutput": {
      "description": "Everything `Core::step` produces for one second.",
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApproachState"
          }
        },
        "requests": {
          "description": "Controller wish per junction, before the envelope.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Command"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "states",
        "requests",
        "commands"
      ]
    }
  }
}
